<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared data contracts: song package metadata, quality scoring, UltraStar song.txt and the
       inference worker's JSONL protocol. Deliberately has no package dependencies so every layer
       (app, tests, future tools) can reference it. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Singularity.Contracts</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
