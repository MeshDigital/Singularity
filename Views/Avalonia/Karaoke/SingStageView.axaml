<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Singularity.ViewModels.Karaoke"
             xmlns:k="clr-namespace:Singularity.Views.Avalonia.Karaoke"
             x:Class="Singularity.Views.Avalonia.Karaoke.SingStageView"
             x:DataType="vm:SingViewModel"
             x:CompileBindings="True"
             Background="Black" Foreground="White">
    <!-- What the audience sees: shown in the main window, or full screen on the projector. -->
    <Grid>
        <!-- Bottom layer, for songs without a synced video: the cover, blurred, in a glow of its own colour.
             The music video is drawn over it by the stage itself (Skia), never as a native window, which
             would paint over the notes. -->
        <Grid>
            <Grid.Background>
                <RadialGradientBrush Center="50%,45%" GradientOrigin="50%,45%" RadiusX="75%" RadiusY="75%">
                    <GradientStop Offset="0" Color="{Binding Glow}"/>
                    <GradientStop Offset="1" Color="Black"/>
                </RadialGradientBrush>
            </Grid.Background>
            <Image Source="{Binding Background}" Stretch="UniformToFill" Opacity="0.28">
                <Image.Effect>
                    <BlurEffect Radius="40"/>
                </Image.Effect>
            </Image>
        </Grid>

        <k:SingStage/>

        <StackPanel Margin="24,16" VerticalAlignment="Top" HorizontalAlignment="Left" IsVisible="{Binding IsOnProjector}">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="{Binding Artist}" Foreground="#BBB" FontSize="16"/>
        </StackPanel>

        <!-- Results: a glass card per singer in their lane colour, sliding in, with a score meter that fills. -->
        <Border IsVisible="{Binding ShowResults}">
            <Border.Background>
                <RadialGradientBrush Center="50%,45%" GradientOrigin="50%,45%" RadiusX="80%" RadiusY="80%">
                    <GradientStop Offset="0" Color="#E8101420"/>
                    <GradientStop Offset="1" Color="#F0000000"/>
                </RadialGradientBrush>
            </Border.Background>
            <Border.Styles>
                <Style Selector="Border.card">
                    <Style.Animations>
                        <Animation Duration="0:0:0.7" FillMode="Forward" Easing="CubicEaseOut">
                            <KeyFrame Cue="0%">
                                <Setter Property="Opacity" Value="0"/>
                                <Setter Property="TranslateTransform.Y" Value="40"/>
                            </KeyFrame>
                            <KeyFrame Cue="100%">
                                <Setter Property="Opacity" Value="1"/>
                                <Setter Property="TranslateTransform.Y" Value="0"/>
                            </KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
                <Style Selector="Border.meter">
                    <Style.Animations>
                        <Animation Duration="0:0:1.6" Delay="0:0:0.3" FillMode="Both" Easing="QuarticEaseOut">
                            <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="0"/></KeyFrame>
                            <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="1"/></KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
                <Style Selector="Border.badge">
                    <Style.Animations>
                        <Animation Duration="0:0:1.2" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.7"/></KeyFrame>
                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
            </Border.Styles>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <StackPanel HorizontalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Artist}" FontSize="18" Foreground="#AAB" HorizontalAlignment="Center"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Results}" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="36" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlayerResult">
                            <Border Classes="card" Width="380" CornerRadius="18" Padding="30,22" Background="#B4141826"
                                    BorderBrush="{Binding Accent}" BorderThickness="0,4,0,0" BoxShadow="0 10 40 0 #A0000000">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Foreground="{Binding Accent}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Score, StringFormat={}{0:N0}}" FontSize="80" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <Border Width="320" Height="10" CornerRadius="5" Background="#26FFFFFF" HorizontalAlignment="Center">
                                        <Border Classes="meter" Width="{Binding MeterWidth}" CornerRadius="5" Background="{Binding Accent}"
                                                HorizontalAlignment="Left" RenderTransformOrigin="0%,50%"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" Foreground="#FFD23C" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="0,10,0,0">
                                        <TextBlock Text="Notes" Foreground="#AAB"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Notes}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="1" Text="Golden notes" Foreground="#AAB" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Golden}" Foreground="#FFD23C" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="2" Text="Line bonus" Foreground="#AAB" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LineBonus}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Lines}" Foreground="#889" HorizontalAlignment="Center"/>
                                    <Border Classes="badge" Background="#33FFD23C" CornerRadius="12" Padding="14,5" HorizontalAlignment="Center"
                                            IsVisible="{Binding HasHighScore}" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding HighScoreText}" Foreground="#FFD23C" FontSize="18" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Background="#80141826" CornerRadius="14" Padding="22,12" HorizontalAlignment="Center" IsVisible="{Binding HasTopScores}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding TopScoresTitle}" Foreground="#AAB" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding TopScores}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}" FontSize="15" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button Content="Sing again (R)" Command="{Binding RestartCommand}" Padding="18,8"/>
                    <Button Content="Song select (Enter)" Command="{Binding BackCommand}" Padding="18,8" Classes="accent"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
