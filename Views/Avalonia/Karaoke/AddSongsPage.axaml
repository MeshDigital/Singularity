<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Singularity.ViewModels.Karaoke"
             x:Class="Singularity.Views.Avalonia.Karaoke.AddSongsPage"
             x:DataType="vm:AddSongsViewModel"
             x:CompileBindings="True"
             Background="{DynamicResource BrushBg1}" Foreground="White">
    <UserControl.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Foreground" Value="#0B1A17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="Button.quiet">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style Selector="TextBox.drop">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="MinHeight" Value="54"/>
            <Setter Property="MaxHeight" Value="220"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="32,26">
        <StackPanel Spacing="16" MaxWidth="960" HorizontalAlignment="Left">
            <StackPanel Spacing="6">
                <TextBlock Text="Add songs" FontSize="32" FontWeight="Bold"/>
                <TextBlock Foreground="#9AA" TextWrapping="Wrap" FontSize="14"
                           Text="Paste a Spotify link, or type songs as Artist - Title, one per line. Each song is downloaded, gets a community chart from USDB or an AI chart, and lands in your library with its music video."/>
            </StackPanel>

            <!-- One box for everything: a link or a list. Enter adds; Shift+Enter starts a new line. -->
            <Border Background="#0FFFFFFF" CornerRadius="16" Padding="16" Width="920" HorizontalAlignment="Left">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                    <TextBox x:Name="Input" Classes="drop" Text="{Binding Link}" AcceptsReturn="True" TextWrapping="Wrap"
                             Watermark="https://open.spotify.com/playlist/…   or   Queen - Bohemian Rhapsody"/>
                    <Button Grid.Column="1" Classes="primary" Content="Add" Command="{Binding ImportCommand}"
                            VerticalAlignment="Top" Margin="12,0,0,0" MinHeight="54" MinWidth="110"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10" Margin="2,10,0,0">
                        <Border Background="#264EC9B0" CornerRadius="8" Padding="10,3"
                                IsVisible="{Binding DetectedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding DetectedText}" Foreground="{DynamicResource BrushAccent}" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="Songs · albums · playlists · lists" Foreground="#667" FontSize="12" VerticalAlignment="Center"/>
                        <CheckBox Content="Keep checking this playlist for new songs" IsChecked="{Binding WatchThis}" IsVisible="{Binding IsPlaylistLink}"
                                  FontSize="12" Margin="8,0,0,0"
                                  ToolTip.Tip="Songs added to the playlist on Spotify become karaoke songs by themselves (checked every 30 minutes)."/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{Binding Message}" Foreground="#CCD" TextWrapping="Wrap"
                       IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding OfflineText}" Foreground="#FC6" TextWrapping="Wrap" IsVisible="{Binding IsOffline}"/>

            <WrapPanel Orientation="Horizontal">
                <Button Classes="quiet" Content="Audio file…" Click="OnAddFile" Margin="0,0,10,8"
                        ToolTip.Tip="Make a song from an audio file on this PC"/>
                <Button Classes="quiet" Content="Make karaoke songs from my downloads" Command="{Binding CatchUpCommand}" Margin="0,0,16,8"
                        ToolTip.Tip="For songs downloaded before. Songs already in the collection are skipped."/>
                <CheckBox Content="Every download becomes a karaoke song" IsChecked="{Binding IngestAllDownloads}" Margin="0,0,0,8"
                          ToolTip.Tip="Downloads from Search and other pages too. Songs the collection already has are skipped."/>
            </WrapPanel>
            <TextBlock Text="{Binding FolderText}" Foreground="#667" FontSize="12"/>

            <!-- Playlists checked now and then for songs added on Spotify. -->
            <Border Background="#0AFFFFFF" CornerRadius="12" Padding="14,10" Width="920" HorizontalAlignment="Left" IsVisible="{Binding HasWatched}">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Watched playlists" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="quiet" Content="Check now" Command="{Binding CheckWatchedCommand}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Watched}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WatchedPlaylistRow">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Url}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Status}" Foreground="#889" FontSize="12"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="quiet" Content="Stop watching" VerticalAlignment="Center"
                                            Command="{Binding $parent[ItemsControl].((vm:AddSongsViewModel)DataContext).UnwatchCommand}" CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding HeldText}" Foreground="#FC6" FontSize="12"
                       IsVisible="{Binding HeldText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" Margin="0,18,0,0" Background="Transparent" MaxWidth="960" HorizontalAlignment="Left"
                 IsVisible="{Binding HasRows}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:IngestRowViewModel">
                    <Border Background="#0DFFFFFF" CornerRadius="12" Padding="16,12" Width="900">
                        <Grid ColumnDefinitions="*,240">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Song}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Detail}" Foreground="#889" FontSize="12" TextWrapping="Wrap"
                                           IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="{Binding StateText}" FontSize="13" HorizontalAlignment="Right"
                                           Classes.failed="{Binding IsFailed}" Classes.ready="{Binding IsReady}">
                                    <TextBlock.Styles>
                                        <Style Selector="TextBlock.failed"><Setter Property="Foreground" Value="#F77"/></Style>
                                        <Style Selector="TextBlock.ready"><Setter Property="Foreground" Value="#6C8"/></Style>
                                    </TextBlock.Styles>
                                </TextBlock>
                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="5" CornerRadius="3" IsVisible="{Binding ShowProgress}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
