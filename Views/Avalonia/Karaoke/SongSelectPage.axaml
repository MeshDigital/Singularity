<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Singularity.ViewModels.Karaoke"
             xmlns:controls="clr-namespace:Singularity.Views.Avalonia.Controls"
             x:Class="Singularity.Views.Avalonia.Karaoke.SongSelectPage"
             x:DataType="vm:SongSelectViewModel"
             x:CompileBindings="True"
             Background="{DynamicResource BrushBg1}" Foreground="White">
    <UserControl.Styles>
        <Style Selector="Button.version">
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Background" Value="#2A2F3A"/>
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,*" Margin="28,24">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock Text="Sing" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="{Binding StatusText}" Foreground="#9AA" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="10" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <TextBlock Text="Sing on" VerticalAlignment="Center" Foreground="#AAB"/>
                    <ComboBox ItemsSource="{Binding StageScreens}" SelectedItem="{Binding SelectedStageScreen}" MinWidth="260"
                              ToolTip.Tip="Show the singing full screen on a projector or TV, and keep this window for the library"/>
                    <Button Content="Rescan" Command="{Binding RefreshCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <TextBlock Text="Text size" VerticalAlignment="Center" Foreground="#AAB"/>
                    <Slider Minimum="0.75" Maximum="2" SmallChange="0.05" LargeChange="0.25" Value="{Binding TextScale}" Width="200"
                            ToolTip.Tip="Size of lyrics, scores and notes on the stage; + and - change it while singing"/>
                    <TextBlock Text="{Binding TextScaleText}" VerticalAlignment="Center" Width="44"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,16,0,12" Spacing="10">
            <TextBox Watermark="Search artist or title" Text="{Binding SearchText}"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Remove vocals for all songs" Command="{Binding StartBatchCommand}"
                        ToolTip.Tip="Separates every song in the background (about 30 s each on the GPU). It pauses while someone sings and can be stopped and resumed any time."/>
                <Button Content="{Binding PauseBatchText}" Command="{Binding PauseBatchCommand}" IsVisible="{Binding IsBatchRunning}"/>
                <Button Content="Stop" Command="{Binding StopBatchCommand}" IsVisible="{Binding IsBatchRunning}"/>
                <TextBlock Text="{Binding BatchText}" VerticalAlignment="Center" Foreground="#AAB" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>

        <!-- ListBox virtualises its items, so thousands of songs scroll smoothly; covers decode on demand. -->
        <!-- The highlighted song, with its music video while the preview plays. -->
        <Border Grid.Row="2" Width="400" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#0DFFFFFF" CornerRadius="14" Padding="14"
                IsVisible="{Binding SelectedSong, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="10">
                <Border Height="208" CornerRadius="10" ClipToBounds="True" Background="#111">
                    <Panel>
                        <Image Source="{Binding SelectedSong.Cover}" Stretch="UniformToFill" Opacity="0.85"/>
                        <controls:VideoSurface IsVisible="{Binding HasPreviewVideo}" VideoPath="{Binding PreviewVideoPath}"
                                               VideoGapMs="{Binding PreviewVideoGapMs}" Clock="{Binding PreviewClock}"/>
                    </Panel>
                </Border>
                <TextBlock Text="{Binding SelectedSong.Title}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SelectedSong.Artist}" Foreground="#BBB" FontSize="15"/>
                <TextBlock Text="{Binding SelectedSong.VersionText}" Foreground="#9BD" FontSize="12" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SelectedSong.Details}" Foreground="#778" FontSize="12"/>
            </StackPanel>
        </Border>

        <ListBox Grid.Row="2" x:Name="SongList" Margin="0,0,416,0" ItemsSource="{Binding Songs}" SelectedItem="{Binding SelectedSong}" Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SongCardViewModel">
                    <Grid ColumnDefinitions="64,*,Auto" Height="72" Background="Transparent">
                        <Border Width="64" Height="64" CornerRadius="6" ClipToBounds="True" Background="#222">
                            <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Artist}" Foreground="#BBB" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Classes="version" Content="◀" IsVisible="{Binding HasVersions}" ToolTip.Tip="Previous version (Left)"
                                        Command="{Binding $parent[ListBox].((vm:SongSelectViewModel)DataContext).PreviousVersionCommand}"
                                        CommandParameter="{Binding}"/>
                                <TextBlock Text="{Binding VersionText}" Foreground="#9BD" FontSize="11" VerticalAlignment="Center"/>
                                <Button Classes="version" Content="▶" IsVisible="{Binding HasVersions}" ToolTip.Tip="Next version (Right)"
                                        Command="{Binding $parent[ListBox].((vm:SongSelectViewModel)DataContext).NextVersionCommand}"
                                        CommandParameter="{Binding}"/>
                                <TextBlock Text="{Binding Details}" Foreground="#778" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="8,0" VerticalAlignment="Center">
                            <Border Background="#E8457A" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" IsVisible="{Binding IsNew}"
                                    ToolTip.Tip="Made from a Spotify link in the last few days">
                                <TextBlock Text="NEW" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <TextBlock Text="Vocals removable" Foreground="#6C8" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding HasStems}"/>
                            <TextBlock Text="{Binding Separating}" Foreground="#FC6" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding IsSeparating}"/>
                            <Button Content="Remove vocals" IsVisible="{Binding CanSeparate}"
                                    ToolTip.Tip="Separate the original vocals with the AI worker (about 40 s on the GPU) so they can be turned off while singing"
                                    Command="{Binding $parent[ListBox].((vm:SongSelectViewModel)DataContext).SeparateCommand}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="Sing"
                                    Command="{Binding $parent[ListBox].((vm:SongSelectViewModel)DataContext).SingCommand}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
