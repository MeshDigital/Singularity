<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Singularity.ViewModels.Karaoke"
             xmlns:k="clr-namespace:Singularity.Views.Avalonia.Karaoke"
             x:Class="Singularity.Views.Avalonia.Karaoke.SingPage"
             x:DataType="vm:SingViewModel"
             x:CompileBindings="True"
             Background="Black" Foreground="White" Focusable="True">
    <Grid>
        <!-- The stage, unless it is on the projector. -->
        <k:SingStageView IsVisible="{Binding !IsOnProjector}"/>

        <!-- Operator view while the stage is on the projector: controls and live scores, so this
             screen stays free for picking the next song. -->
        <StackPanel IsVisible="{Binding IsOnProjector}" Margin="28,80,28,28" Spacing="14">
            <TextBlock Text="{Binding ProjectorText}" Foreground="#9AA"/>
            <TextBlock Text="{Binding Title}" FontSize="34" FontWeight="Bold"/>
            <TextBlock Text="{Binding Artist}" FontSize="20" Foreground="#BBB"/>
            <TextBlock Text="{Binding LiveScores}" FontSize="26" Margin="0,12,0,0"/>
            <ItemsControl ItemsSource="{Binding Results}" IsVisible="{Binding ShowResults}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlayerResult">
                        <TextBlock FontSize="20">
                            <Run Text="{Binding Name}"/>
                            <Run Text="  "/>
                            <Run Text="{Binding Score, StringFormat={}{0:N0}}" FontWeight="Bold"/>
                            <Run Text="  "/>
                            <Run Text="{Binding Title}" Foreground="#FFD23C"/>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding ShowResults}">
                <Button Content="Sing again (R)" Command="{Binding RestartCommand}"/>
                <Button Content="Song select (Enter)" Command="{Binding BackCommand}"/>
            </StackPanel>
        </StackPanel>

        <!-- Top bar: a slim strip over the stage that fades back while singing and comes up under the mouse. -->
        <Grid RowDefinitions="Auto,*,Auto">
            <Border Name="TopBar" Padding="20,12,20,26" IsVisible="{Binding !ShowResults}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#C0000000"/>
                        <GradientStop Offset="1" Color="#00000000"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Styles>
                    <Style Selector="Border#TopBar">
                        <Setter Property="Opacity" Value="0.4"/>
                        <Setter Property="Transitions">
                            <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.25"/></Transitions>
                        </Setter>
                    </Style>
                    <Style Selector="Border#TopBar:pointerover">
                        <Setter Property="Opacity" Value="1"/>
                    </Style>
                    <Style Selector="Border#TopBar Button">
                        <Setter Property="Background" Value="#33FFFFFF"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="CornerRadius" Value="16"/>
                        <Setter Property="Padding" Value="14,6"/>
                    </Style>
                </Border.Styles>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="&#x2190; Back" Command="{Binding BackCommand}"/>
                        <Button Content="Pause" Command="{Binding PauseCommand}"/>
                        <Button Content="Skip intro (S)" Command="{Binding SkipIntroCommand}" IsVisible="{Binding CanSkipIntro}"/>
                        <Button Content="Next song (N)" Command="{Binding NextJukeboxCommand}" IsVisible="{Binding IsJukebox}"/>
                        <Button Content="{Binding VocalsText}" Command="{Binding CycleVocalsCommand}" ToolTip.Tip="Original vocals: off, quiet guide, or full (V)"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" IsVisible="{Binding !IsOnProjector}">
                        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Artist}" Foreground="#BBB" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="#889" FontSize="12" Margin="20,0,20,10" IsVisible="{Binding !ShowResults}"/>
        </Grid>
    </Grid>
</UserControl>
