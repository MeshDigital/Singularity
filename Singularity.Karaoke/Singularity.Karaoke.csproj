<Project Sdk="Microsoft.NET.Sdk">

  <!-- The singing game's core, free of UI and audio-device code: microphone pitch detection,
       scoring and timing. Driven by the app; tested headless. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Singularity.Karaoke</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Singularity.Contracts\Singularity.Contracts.csproj" />
  </ItemGroup>

</Project>
